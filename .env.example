# ============================================================================
#  Sistema CRM - Modelo de variáveis de ambiente (SEM valores secretos)
#  Copie para backend/.env e preencha com as credenciais do seu projeto.
#  O arquivo backend/.env NUNCA deve ir para o Git (ver .gitignore).
# ============================================================================

# Porta da API Express (backend/server.js usa 3001 por padrão)
PORT=3001

# Origens autorizadas a chamar a API (CORS restrito, separado por vírgula).
# O front-end é aberto via file:// e não chama a API hoje; mantido para uso futuro.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ----------------------------------------------------------------------------
# Supabase (somente servidor - NUNCA no front-end / HTML / CSS / JS público)
# ----------------------------------------------------------------------------
# URL do projeto, ex.: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Chave de serviço (service_role). Dá acesso total ao banco e IGNORA o RLS.
# Deve existir APENAS aqui, no ambiente do servidor. Nunca é devolvida pela API.
SUPABASE_SERVICE_ROLE_KEY=

# Senha temporária atribuída automaticamente a usuários sem senha cadastrada.
# Troque este valor antes de publicar o sistema e informe-o somente aos usuários.
DEFAULT_USER_PASSWORD=Crm@2026!Inicial

# ----------------------------------------------------------------------------
# Opcional: usada só se você optar por rodar as migrações de forma automatizada
# (script Node com o pacote `pg`). É a connection string do Postgres do
# Supabase, que contém a senha do banco. Se você preferir aplicar o SQL pelo
# SQL Editor do painel, deixe em branco/remova esta linha.
# ----------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres
