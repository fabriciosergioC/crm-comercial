# CRM
PORT=3001
# Dev local (Live Server na porta 5500):
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
# Produção (VPS): origens que podem chamar a API — frontend na Vercel/domínio próprio.
# Também é liberado automaticamente qualquer hostname terminado em .vercel.app.
# CORS_ORIGIN=https://crm-comercial.com,https://crm-comercial-kappa.vercel.app,https://api.crm-comercial.com

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp via Baileys (não oficial)
WHATSAPP_PROVIDER=baileys
# Opcional: telefone com DDI, somente números, usado para solicitar Pairing Code.
# Se vazio, o CRM exibirá QR Code quando você clicar em conectar.
WHATSAPP_PAIRING_PHONE=
# Pasta onde a sessão do WhatsApp ficará salva para não pedir QR novamente.
WHATSAPP_AUTH_DIR=./data/whatsapp-auth
# Reconectar o WhatsApp automaticamente ao subir o backend (reaproveita a sessão
# salva em WHATSAPP_AUTH_DIR). Coloque false para exigir conexão manual pela UI.
WHATSAPP_AUTOSTART=true

# Lembretes de follow-up no celular (agendador no backend)
# Número de WhatsApp que RECEBE os lembretes (o seu celular), só dígitos, com DDI.
# Ex.: 5531999990000. Se vazio, os lembretes ficam desativados.
FOLLOWUP_NOTIFY_PHONE=
# Intervalo de verificação/repetição dos avisos, em minutos (padrão 15).
# Regra: avisa os follow-ups pendentes VENCIDOS ou QUE VENCEM HOJE, e repete a
# cada intervalo até serem confirmados (concluídos) no menu de follow-ups.
FOLLOWUP_SCHEDULER_INTERVAL_MIN=15
# Fuso usado para definir "hoje" e formatar as datas (padrão America/Sao_Paulo).
TZ=America/Sao_Paulo
# Coloque false para desligar o agendador sem apagar o número.
FOLLOWUP_NOTIFY_ENABLED=true

# Lembretes da AGENDA no Windows (backend/services/agendaNotifier.js)
# Notificação nativa do Windows 10/11 (toast), sem instalar nada. Só funciona com
# o backend local aberto (run-crm.bat) — na Vercel serverless o agendador não roda.
# Cobre os dois conjuntos do menu Agenda: eventos (reunião, demonstração, tarefa,
# compromisso) e retornos (follow-ups pendentes). Cada aviso sai uma única vez por
# item/fase; o controle fica em data/agenda-notifier-state.json.
AGENDA_NOTIFY_ENABLED=true
# De quanto em quanto tempo o backend varre a agenda, em minutos (padrão 5).
AGENDA_NOTIFY_INTERVAL_MIN=5
# Antecedência do lembrete, em minutos (padrão 15). 0 desliga o aviso antecipado.
AGENDA_NOTIFY_LEAD_MIN=15
# Minutos depois do horário para o item contar como atrasado (padrão 30).
AGENDA_NOTIFY_LATE_MIN=30
# Resumo do dia (1x por dia, ao abrir o CRM) — true/false.
AGENDA_NOTIFY_SUMMARY=true
# Nome do app que aparece no topo do aviso (padrão "Gestão Comercial CRM").
# WINDOWS_TOAST_APP_ID=Gestão Comercial CRM


# Geração de áudio por IA no chat do CRM (ElevenLabs)
# Configure a chave e o Voice ID no backend persistente; nunca no frontend.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Opcional. Padrão: eleven_multilingual_v2
# eleven_turbo_v2_5 responde mais rápido e aceita TTS_SPEED; use este se quiser voz acelerada.
# eleven_flash_v2_5 é o turbo com latência ainda menor.
# eleven_v3 é o modelo mais humano: aceita TTS_SPEED até 2.0 e entende pausas escritas
# no texto como [pause], além de tags de emoção ([excited], [curious]).
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Ajustes de voz (todos opcionais).
# Estabilidade: 0 = mais expressiva e variada, 1 = mais uniforme e estável.
TTS_STABILITY=0.30
# Semelhança com a voz original: 0 a 1.
TTS_SIMILARITY_BOOST=0.85
# Estilo: 0 a 1. Só tem efeito nos modelos turbo, flash e v3.
TTS_STYLE=0.25
# Realce de timbre: 1 liga, 0 desliga.
TTS_SPEAKER_BOOST=1
# Velocidade no próprio provedor. Turbo e flash aceitam até 1.2; eleven_v3 aceita até 2.0.
# Fora da faixa do modelo o valor é ignorado (volta para 1).
TTS_SPEED=1.2
# Aceleração extra pelo FFmpeg, sem mudar o tom da voz: 0.8 a 1.6. 1 desliga.
# Use para passar de 1.2 quando o modelo não aceita speed.
TTS_TEMPO=1

# Perfis de voz que aparecem como botão no chat ("Rápida" usa o modelo acima,
# "Natural" usa o eleven_v3). Escolha qual já vem marcado ao abrir a página.
TTS_DEFAULT_PROFILE=rapida
# Modelo e regulagens do perfil Natural (independem das linhas acima).
# Velocidade: 1.1 soa relaxado, 1.35 compensate as pausas. O turbo a 1.2 fala bem mais rápido.
TTS_NATURAL_MODEL_ID=eleven_v3
TTS_NATURAL_SPEED=1.1
TTS_NATURAL_STABILITY=0.30
TTS_NATURAL_STYLE=0.35
# Tags que o eleven_v3 entende escritas no texto. Qualquer outra coisa entre
# colchetes é descartada antes de enviar, e um [NOME] sem preencher vira erro.
TTS_V3_TAGS=pause,excited,curious,calm,whisper
